# OSLO Release 1 — Environment Configuration (TEMPLATE / EXAMPLE)
# Copy to `.env` in the APPLICATION repo and fill real values. NEVER commit `.env`.
# No secret VALUES belong in this file or any commit (Deployment Governance section 7).
# Numeric values below are the adopted (tunable) Calibration Defaults — DL-044 constituent C.

# =========================================================================
# Environment
# =========================================================================
APP_ENV=development            # development | staging | production
LOG_LEVEL=info

# =========================================================================
# Datastores (local Dev defaults match docker-compose.yml)
# =========================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=oslo
POSTGRES_PASSWORD=            # set locally; injected from secret store in Staging/Prod
POSTGRES_DB=oslo

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

MONGO_URI=mongodb://localhost:27017
MONGO_USER=oslo
MONGO_PASSWORD=

QDRANT_URL=http://localhost:6333

REDIS_URL=redis://localhost:6379

# =========================================================================
# LLM providers (provider abstraction: OpenAI primary, Anthropic fallback)
# Inject real keys from the secret store — do NOT paste keys here.
# =========================================================================
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =========================================================================
# Observability (OpenTelemetry -> Grafana)
# =========================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=oslo-backend

# =========================================================================
# Calibration Defaults (DL-044 constituent C — tunable config, not architecture)
# =========================================================================
# Determinism / replay tolerances
REPLAY_RECORD_TOLERANCE=0               # exact: any diff is a Critical trust failure
REPLAY_RULE_TOLERANCE=0                 # exact given same inputs + rule version
REPLAY_AI_NUMERIC_TOLERANCE_POINTS=7    # +/- 7 on 0-100 AND same band
REPLAY_SET_OVERLAP_MIN=0.90             # >= 90% stable-identity overlap

# Confidence bands (0-100)
CONFIDENCE_BAND_LOW_MAX=49              # 0-49 low
CONFIDENCE_BAND_MEDIUM_MAX=74           # 50-74 medium; 75-100 high
CONFIDENCE_BAND_EDGE_GUARD_POINTS=3     # within +/-3 of a boundary -> display lower band

# Drift thresholds
DRIFT_OUTCOME_POINTS=10                 # >= 10 pts or band change -> surface (feature)
DRIFT_ACCEPTANCE_POINTS=10              # >= 10 pts or band change vs pinned acceptance
CONFIDENCE_INFLATION_POINTS=10          # rise >= 10 with no new Attested input -> trust flag

# Retention (days; 0 = project-lifetime+1yr handled in app logic)
RETENTION_OPERATIONAL_LOGS_DAYS=90
RETENTION_AUDIT_RECEIPTS_DAYS=365       # >= 1 year; owner to confirm vs compliance
# Canonical records: project lifetime + 1 year, append-only (enforced in app, not a TTL)
