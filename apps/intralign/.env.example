# Public local endpoints
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=copy-from-pnpm-supabase-status
OSLO_API_URL=http://127.0.0.1:8000

# API-only settings (never expose service-role credentials to the browser)
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:55322/postgres
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=copy-from-pnpm-supabase-status
WEB_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=55325
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_EXTENDED_MODEL=gpt-5.6-terra
# Optional transport/schema fallback. Leave blank to fail closed.
OPENAI_FALLBACK_MODEL=
OPENAI_MAX_RETRIES=0
ANALYSIS_ARTIFACT_WORKER_THREADS=4
# Use `supabase` outside local development so original uploads survive dyno restarts.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_BUCKET=oslo-source-documents

# Optional Stripe test-mode billing. Without all four values, non-billing
# entitlements and Outcome archive stay available; checkout fails closed with 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_MONTHLY_PRICE_ID=
STRIPE_BASIC_ANNUAL_PRICE_ID=

# Optional local seed overrides
OSLO_LOCAL_ADMIN_EMAIL=admin@oslo.local
OSLO_LOCAL_ADMIN_PASSWORD=OsloLocalAdmin123!
