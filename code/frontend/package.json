{
  "name": "oslo-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OSLO Release 1 frontend — React + Vite + MUI + TanStack, Vercel. Orval-generated API client.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:schema": "python ../scripts/export_openapi.py",
    "api:gen": "orval --config ./orval.config.ts",
    "api:client": "npm run api:schema && npm run api:gen",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/material": "^5.16.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-router": "^1.45.0",
    "axios": "^1.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^29.1.1",
    "orval": "^6.31.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "form-data": "^4.0.6"
  }
}
