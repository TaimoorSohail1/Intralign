# OSLO Release 1 — Environment Configuration (TEMPLATE / EXAMPLE) — DL-054 binding
# Copy to `.env` and fill real values. NEVER commit `.env`.
# No secret VALUES belong in this file or any commit (Deployment Governance §7).
# Numeric values below are the adopted (tunable) Calibration Defaults — DL-044 constituent C.

# =========================================================================
# Environment
# =========================================================================
APP_ENV=development            # development | staging | production
LOG_LEVEL=info

# =========================================================================
# Supabase (Postgres + Auth/GoTrue + RLS + pgvector + Storage) — DL-054
# Local: from `supabase start` output. Staging/Prod: from the secret store.
# =========================================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth (GoTrue) HS256 JWT signing secret — verifies caller access tokens
# (DTM-0036; backend/platform/auth.py). PLACEHOLDER ONLY — never commit a real
# value. Local: copy the `JWT secret` from `supabase status`. Staging/Prod: inject
# from the platform secret store (Deployment Governance §7).
SUPABASE_JWT_SECRET=
# Direct Postgres (migrations / repository layer)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
PGVECTOR_DIM=1536              # embedding dimensionality (provider/model dependent)

# =========================================================================
# Neo4j (knowledge graph) — local Dev defaults match docker-compose.yml
# =========================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =========================================================================
# Redis (sessions / cache / event buffers)
# =========================================================================
REDIS_URL=redis://localhost:6379

# =========================================================================
# LLM providers — provider abstraction (Pydantic AI + adapter), DL-054 §5
# PRIMARY = internal `gemma4` on a local Llama runtime (OpenAI-compatible
# endpoint, run natively / NOT dockerised) — DL-069 / ADR-0007. OpenAI/Anthropic
# are a DISABLED-by-default fallback (flip config + provide a key to re-enable).
# =========================================================================
# Internal (primary) LLM — the local Llama runtime's OpenAI-compatible base_url.
# Set this to your runtime's /v1 endpoint (the owner/ops sets the live value);
# the commented example shows the SHAPE — do NOT treat it as the active URL.
# A live call also requires OSLO_LLM_LIVE=1 (PR CI leaves it unset).
# OSLO_LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama; or :8080/v1 for llama.cpp
OSLO_LLM_BASE_URL=
OSLO_LLM_MODEL=gemma4          # the internal model id (owner default: gemma4)
OSLO_LLM_API_KEY=              # optional; the local server ignores it (dummy used if unset)
OSLO_LLM_LIVE=                 # set to 1 ONLY for dev/nightly live calls; unset in PR CI
# Disabled-by-default fallback (OpenAI/Anthropic) — optional; inject from the
# secret store only if/when the owner re-enables the external fallback.
LLM_PRIMARY_PROVIDER=internal
LLM_FALLBACK_PROVIDER=openai
OPENAI_API_KEY=                # optional (disabled fallback)
ANTHROPIC_API_KEY=             # optional (disabled fallback)

# =========================================================================
# Observability — OpenTelemetry -> Grafana (retained) + LangSmith (complement, DL-054)
# =========================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=oslo-backend
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oslo-r1

# =========================================================================
# Calibration Defaults (DL-044 constituent C — tunable config, not architecture)
# =========================================================================
# Determinism / replay tolerances
REPLAY_RECORD_TOLERANCE=0               # exact: any diff is a Critical trust failure
REPLAY_RULE_TOLERANCE=0                 # exact given same inputs + rule version
REPLAY_AI_NUMERIC_TOLERANCE_POINTS=7    # +/- 7 on 0-100 AND same band
REPLAY_SET_OVERLAP_MIN=0.90             # >= 90% stable-identity overlap

# Confidence bands (0-100)
CONFIDENCE_BAND_LOW_MAX=49              # 0-49 low
CONFIDENCE_BAND_MEDIUM_MAX=74           # 50-74 medium; 75-100 high
CONFIDENCE_BAND_EDGE_GUARD_POINTS=3     # within +/-3 of a boundary -> display lower band

# Drift thresholds
DRIFT_OUTCOME_POINTS=10                 # >= 10 pts or band change -> surface (feature)
DRIFT_ACCEPTANCE_POINTS=10              # >= 10 pts or band change vs pinned acceptance
CONFIDENCE_INFLATION_POINTS=10          # rise >= 10 with no new Attested input -> trust flag

# Retention (days; canonical records = project lifetime + 1yr, append-only in app logic)
RETENTION_OPERATIONAL_LOGS_DAYS=90
RETENTION_AUDIT_RECEIPTS_DAYS=365       # owner-pending (OPEN_TBD C1) — proposed default, not ratified
