# OSLO Release 1 — Environment Configuration (TEMPLATE / EXAMPLE) — DL-054 binding
# Copy to `.env` and fill real values. NEVER commit `.env`.
# No secret VALUES belong in this file or any commit (Deployment Governance §7).
# Numeric values below are the adopted (tunable) Calibration Defaults — DL-044 constituent C.

# =========================================================================
# Environment
# =========================================================================
APP_ENV=development            # development | staging | production
LOG_LEVEL=info

# =========================================================================
# Supabase (Postgres + Auth/GoTrue + RLS + pgvector + Storage) — DL-054
# Local: from `supabase start` output. Staging/Prod: from the secret store.
# =========================================================================
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres (migrations / repository layer)
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
PGVECTOR_DIM=1536              # embedding dimensionality (provider/model dependent)

# =========================================================================
# Neo4j (knowledge graph) — local Dev defaults match docker-compose.yml
# =========================================================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# =========================================================================
# Redis (sessions / cache / event buffers)
# =========================================================================
REDIS_URL=redis://localhost:6379

# =========================================================================
# LLM providers — provider abstraction (Pydantic AI + adapter), DL-054 §5
# OpenAI primary, Anthropic fallback. Inject real keys from the secret store.
# =========================================================================
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# =========================================================================
# Observability — OpenTelemetry -> Grafana (retained) + LangSmith (complement, DL-054)
# =========================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=oslo-backend
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oslo-r1

# =========================================================================
# Calibration Defaults (DL-044 constituent C — tunable config, not architecture)
# =========================================================================
# Determinism / replay tolerances
REPLAY_RECORD_TOLERANCE=0               # exact: any diff is a Critical trust failure
REPLAY_RULE_TOLERANCE=0                 # exact given same inputs + rule version
REPLAY_AI_NUMERIC_TOLERANCE_POINTS=7    # +/- 7 on 0-100 AND same band
REPLAY_SET_OVERLAP_MIN=0.90             # >= 90% stable-identity overlap

# Confidence bands (0-100)
CONFIDENCE_BAND_LOW_MAX=49              # 0-49 low
CONFIDENCE_BAND_MEDIUM_MAX=74           # 50-74 medium; 75-100 high
CONFIDENCE_BAND_EDGE_GUARD_POINTS=3     # within +/-3 of a boundary -> display lower band

# Drift thresholds
DRIFT_OUTCOME_POINTS=10                 # >= 10 pts or band change -> surface (feature)
DRIFT_ACCEPTANCE_POINTS=10              # >= 10 pts or band change vs pinned acceptance
CONFIDENCE_INFLATION_POINTS=10          # rise >= 10 with no new Attested input -> trust flag

# Retention (days; canonical records = project lifetime + 1yr, append-only in app logic)
RETENTION_OPERATIONAL_LOGS_DAYS=90
RETENTION_AUDIT_RECEIPTS_DAYS=365       # owner-pending (OPEN_TBD C1) — proposed default, not ratified
